generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Projects {
  id   Int    @id @default(autoincrement())
  name String
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}
